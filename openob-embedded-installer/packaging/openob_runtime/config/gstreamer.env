# Edita estas rutas según tu instalación de GStreamer.
# Nota: el launcher añadirá GstBin al PATH y exportará GI_TYPELIB_PATH.

GstBin=C:\Program Files\gstreamer\1.0\msvc_x86_64\bin
GI_TYPELIB_PATH=C:\Program Files\gstreamer\1.0\msvc_x86_64\lib\girepository-1.0

# Opcional: ruta al site-packages de GStreamer (donde vive el módulo `gi`).
# Si se omite, el launcher intentará derivarlo desde GstBin como: <root>\lib\site-packages
GstPySitePackages=C:\Program Files\gstreamer\1.0\msvc_x86_64\lib\site-packages
